{
  "name": "callwise",
  "private": true,
  "version": "0.1.0",
  "description": "Callwise for Salesforce",
  "license": "BSD-3-Clause",
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern \"**/lwc/**/*.js\"",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "test:unit:coverage": "sfdx-lwc-jest --coverage -- --passWithNoTests",
    "prettier": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --write \"**/*.{cls,trigger,js,html,css,json,md,xml,yml,yaml}\"",
    "prettier:verify": "prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --check \"**/*.{cls,trigger,js,html,css,json,md,xml,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,trigger,js,html,css,json,md,xml,yml,yaml}": [
      "prettier --write"
    ],
    "**/lwc/**/*.js": [
      "eslint"
    ]
  }
}
